# Variables para correr notification-service desde el IDE (npm run start:dev).
# Copia este archivo como .env (el .env no se sube al repositorio).
# En Docker Compose estas variables las pone docker-compose.yml.

NODE_ENV=development
PUERTO=8086

# Base de desarrollo. Para levantar una con Docker:
#   docker run -d --name notification-db-dev -p 5436:5432 -e POSTGRES_USER=notification -e POSTGRES_PASSWORD=notification -e POSTGRES_DB=notification postgres:18-alpine
# Después, para aplicar las migraciones: npm run prisma:migrar
DATABASE_URL=postgresql://notification:notification@localhost:5436/notification?schema=public

# RabbitMQ (opcional). Sin esta variable, el servicio no consume eventos. Para
# usar el RabbitMQ de Docker Compose, publica su puerto 5672 con un
# docker-compose.override.yml (docs/rabbitmq.md §7):
# RABBITMQ_URL=amqp://suertudometro:rabbitmq-dev@localhost:5672

# Servidor de correo (opcional). Sin SMTP_HOST, los correos quedan pendientes.
# El puerto SMTP de Mailpit se publica igual que el de RabbitMQ.
# SMTP_HOST=localhost
# SMTP_PUERTO=1025
# SMTP_REMITENTE=Suertudómetro <avisos@suertudometro.local>
# Dirección de la aplicación, para los enlaces de los correos.
# URL_FRONTEND=http://localhost:4200
# Cada cuántos milisegundos se buscan correos pendientes (por defecto, 2000).
# CORREO_INTERVALO_MS=2000
