# Variables para correr identity-service desde el IDE (npm run start:dev).
# Copia este archivo como .env (el .env no se sube al repositorio).
# En Docker Compose estas variables las pone docker-compose.yml.

NODE_ENV=development
PUERTO=8081

# Base de desarrollo. Para levantar una con Docker:
#   docker run -d --name identity-db-dev -p 5433:5432 -e POSTGRES_USER=identity -e POSTGRES_PASSWORD=identity -e POSTGRES_DB=identity postgres:18-alpine
# Después, para aplicar las migraciones: npm run prisma:migrar
DATABASE_URL=postgresql://identity:identity@localhost:5433/identity?schema=public
