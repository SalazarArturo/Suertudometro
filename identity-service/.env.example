# Variables para correr identity-service desde el IDE (npm run start:dev).
# Copia este archivo como .env (el .env no se sube al repositorio).
# En Docker Compose estas variables las pone docker-compose.yml.

NODE_ENV=development
PUERTO=8081

# Base de desarrollo. Para levantar una con Docker:
#   docker run -d --name identity-db-dev -p 5433:5432 -e POSTGRES_USER=identity -e POSTGRES_PASSWORD=identity -e POSTGRES_DB=identity postgres:18-alpine
# Después, para aplicar las migraciones: npm run prisma:migrar
DATABASE_URL=postgresql://identity:identity@localhost:5433/identity?schema=public

# JWT (docs/servicios/identity-service.md §5.1). api-gateway usa el mismo secreto.
# Mínimo 32 bytes. Para generar uno:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRETO=cambia-este-secreto-de-desarrollo-de-32-bytes
# Duración del token en segundos (1 hora). No hay refresh token.
JWT_DURACION=3600

# Primer administrador: se crea al arrancar si no existe una cuenta con este
# correo. Su nombre es fijo («Administrador»). La contraseña: de 8 a 128 caracteres.
ADMIN_CORREO=admin@suertudometro.local
ADMIN_CONTRASENA=cambia esta clave del administrador
