# Variables de docker-compose.yml. Copia este archivo como .env (el .env no se
# sube al repositorio) y cambia los valores que quieras.

# Secreto con el que identity-service firma los tokens y el api-gateway los
# valida (HS256, 32 bytes o más). Para generar uno:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRETO=cambia-este-secreto-de-desarrollo-de-32-bytes
# Duración del token en segundos (1 hora). No hay refresh token.
JWT_DURACION=3600

# Primer administrador: identity-service lo crea al arrancar si no existe una
# cuenta con este correo. La contraseña, de 8 a 128 caracteres.
ADMIN_CORREO=admin@suertudometro.local
ADMIN_CONTRASENA=cambia-esta-clave-del-administrador

# Contraseña de la base identity-db. Solo letras, números y guiones, porque va
# dentro de la URL de conexión.
IDENTITY_DB_CONTRASENA=identity-dev
