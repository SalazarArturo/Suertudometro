# Variables de docker-compose.yml. Copia este archivo como .env (el .env no se
# sube al repositorio) y cambia los valores que quieras.

# Secreto con el que identity-service firma los tokens y el api-gateway los
# valida (HS256, 32 bytes o más). Para generar uno:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRETO=cambia-este-secreto-de-desarrollo-de-32-bytes
# Duración del token en segundos (1 hora). No hay refresh token.
JWT_DURACION=3600

# Primer administrador: identity-service lo crea al arrancar si no existe una
# cuenta con este correo. La contraseña, de 8 a 128 caracteres.
ADMIN_CORREO=admin@suertudometro.local
ADMIN_CONTRASENA=cambia-esta-clave-del-administrador

# Contraseñas de las bases de cada servicio. Solo letras, números y guiones,
# porque van dentro de la URL de conexión.
IDENTITY_DB_CONTRASENA=identity-dev
CAMPAIGN_DB_CONTRASENA=campaign-dev
CONTRIBUTION_DB_CONTRASENA=contribution-dev
UPDATE_DB_CONTRASENA=update-dev
SEARCH_DB_CONTRASENA=search-dev
NOTIFICATION_DB_CONTRASENA=notification-dev

# Claves secretas de Django para update-service y search-service: Django las
# usa para firmar datos internos (no tienen que ver con los tokens). Para
# generar una:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
UPDATE_DJANGO_CLAVE_SECRETA=cambia-esta-clave-secreta-de-django
SEARCH_DJANGO_CLAVE_SECRETA=cambia-esta-otra-clave-secreta-de-django

# Usuario de RabbitMQ: lo usan todos los servicios y sirve para entrar a la
# consola (http://localhost:15672). La clave, solo letras, números y guiones,
# porque va dentro de la URL de conexión (amqp://usuario:clave@rabbitmq:5672).
RABBITMQ_USUARIO=suertudometro
RABBITMQ_CLAVE=rabbitmq-dev
