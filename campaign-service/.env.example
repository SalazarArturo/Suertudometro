# Base de datos PostgreSQL 18 (campaign-db)
POSTGRES_DB=campaign_db
POSTGRES_USER=campanas
POSTGRES_PASSWORD=campanas
CAMPAIGN_DB_PORT=5433

# RabbitMQ 4.3
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Servicio campaign-service
CAMPAIGN_SERVICE_PORT=8082
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/campaign_db
SPRING_DATASOURCE_USERNAME=campanas
SPRING_DATASOURCE_PASSWORD=campanas
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
CAMPANA_DIRECTORIO_IMAGENES=./target/campaign-images
